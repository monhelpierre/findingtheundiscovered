# Backend settings. Locally everything has a default; on Cloud Run set these as environment
# variables / secrets (see backend/README.md, section 7). Never commit a real .env.

DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Hosts the backend answers to. A leading dot allows all subdomains.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to POST forms (the Django admin), e.g. https://YOUR_PROJECT.web.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Empty = SQLite (backend/db.sqlite3). Cloud SQL example:
#   postgres://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Shared secret for adding team notes in the web app (header X-Team-Token). Locally: dev-token.
TEAM_TOKEN=

# Where the exported JSON is. Default: ../data/export (in the container: /app/data/export).
ANALOG_EXPORT_DIR=
